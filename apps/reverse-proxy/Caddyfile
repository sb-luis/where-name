{ # global options
    admin off # theres no need for the admin api in railway's environment
    persist_config off # storage isn't persistent anyway
    auto_https off # railway handles https for us, this would cause issues if left enabled
    log { # runtime logs
        format console # set runtime log format to console mode 
    }
    servers { # server options
        trusted_proxies static private_ranges # trust railway's proxy
    }
}

:{$PORT} { # site block, listens on the $PORT environment variable, automatically assigned by railway
    log { # access logs
        format console # set access log format to console mode
    }

    # Handle API requests — handle_path strips the /api prefix before forwarding
    handle_path /api/* {
        reverse_proxy {$BACKEND_ENDPOINT} {
            header_up X-Real-IP {http.request.remote.host}
        }
    }

    # WebSocket connection — proxied directly, no prefix to strip
    reverse_proxy /ws {$BACKEND_ENDPOINT} {
        header_up X-Real-IP {http.request.remote.host}
    }

    # PostHog ingestion
    handle_path /ingest/static/* {
        reverse_proxy https://eu-assets.i.posthog.com {
            header_up Host eu-assets.i.posthog.com
        }
    }
    handle_path /ingest/* {
        reverse_proxy https://eu.i.posthog.com {
            header_up Host eu.i.posthog.com
        }
    }


    # Handle all other requests to frontend
    reverse_proxy /* {$FRONTEND_ENDPOINT}
}